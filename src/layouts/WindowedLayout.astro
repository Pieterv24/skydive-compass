---
import { panda } from '@panda/jsx';
---

<panda.div
  width="full"
  height="fit-content"
  backgroundColor="background"
  flexGrow="1"
  display="flex"
>
  <panda.div
    width="full"
    backgroundColor="background_card"
    flexGrow="1"
    roundedTop="4xl"
    paddingTop="4"
    marginX={{ base: '0', md: '4', '2xl': '8' }}
    shadow={{ base: 'none', md: 'sm_window_shadow' }}
  >
    <slot />
  </panda.div>
</panda.div>
