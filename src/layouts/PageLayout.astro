---
import BaseLayout from './BaseLayout.astro';
import TopBar from '~/components/TopBar.astro';
import WindowedLayout from './WindowedLayout.astro';

const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
  <TopBar />
  <WindowedLayout>
    <h1 class="items-center text-center text-4xl text-black dark:text-white">
      {pageTitle}
    </h1>
    <slot />
  </WindowedLayout>
</BaseLayout>
