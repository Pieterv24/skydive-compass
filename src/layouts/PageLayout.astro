---
import { panda, Center } from '@panda/jsx';

import BaseLayout from './BaseLayout.astro';
import TopBar from '~/components/TopBar.astro';
import WindowedLayout from './WindowedLayout.astro';

const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
  <TopBar />
  <WindowedLayout>
    <Center>
      <panda.h1 fontFamily="heading" fontSize="4xl">
        {pageTitle}
      </panda.h1>
    </Center>
    <slot />
  </WindowedLayout>
</BaseLayout>
