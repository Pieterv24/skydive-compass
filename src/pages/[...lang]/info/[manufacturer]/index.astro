---
import { getCollection } from 'astro:content';

import {
  buildStaticPaths,
  getLangFromUrl,
  useTranslatedPath,
} from '@i18n/utils';
import PageLayout from '@layouts/PageLayout.astro';
import ItemCard from '@components/ItemCard.astro';
import ItemCardTag from '@components/ItemCardTag.astro';

export async function getStaticPaths() {
  const canopies = await getCollection('canopies');
  const manufacturers = await getCollection('manufacturers');

  return buildStaticPaths(
    manufacturers.map(manufacturer => {
      const filteredCanopies = canopies.filter(
        canopy => canopy.data.manufacturerSlug === manufacturer.id,
      );
      return {
        params: { manufacturer: manufacturer.id },
        props: { manufacturer, filteredCanopies },
      };
    }),
  );
}

const { manufacturer, filteredCanopies } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<PageLayout pageTitle={manufacturer.data.name}>
  <section
    class="bg-base-lighter border-base-lighter mx-2 mb-8 rounded-2xl border px-6 py-4 sm:mx-4 md:mx-8"
  >
    <h2 class="text-bw mb-2 text-2xl font-bold">{manufacturer.data.name}</h2>
    <div class="mb-2 flex flex-wrap items-center gap-4">
      {
        manufacturer.data.countryCode && (
          <ItemCardTag>
            {manufacturer.data.countryCode.toUpperCase()}
          </ItemCardTag>
        )
      }
      {
        manufacturer.data.url && (
          <a
            href={manufacturer.data.url}
            target="_blank"
            rel="noopener"
            class="text-primary text-sm underline"
          >
            Website
          </a>
        )
      }
    </div>
    {
      manufacturer.data.remarks && (
        <p class="text-bw/80 mb-1 text-xs italic">
          {manufacturer.data.remarks[lang] || manufacturer.data.remarks.en}
        </p>
      )
    }
  </section>
  <h3 class="text-bw mb-4 px-2 text-xl font-semibold sm:px-4 md:px-8">
    Canopies by {manufacturer.data.name}
  </h3>
  <div
    class="grid grid-cols-1 gap-8 px-2 sm:grid-cols-2 sm:px-4 md:grid-cols-3 md:px-8"
  >
    {
      filteredCanopies.map(canopy => (
        <ItemCard
          href={translatePath(`/info/${manufacturer.id}/${canopy.data.slug}`)}
          title={canopy.data.name}
        >
          <ItemCardTag>Cells: {canopy.data.cells}</ItemCardTag>
          <ItemCardTag>Category: {canopy.data.category}</ItemCardTag>
        </ItemCard>
      ))
    }
  </div>
</PageLayout>
