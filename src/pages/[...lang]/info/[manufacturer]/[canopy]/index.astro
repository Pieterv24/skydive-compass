---
import { getCollection } from 'astro:content';

import {
  buildStaticPaths,
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
  type TranslationKey,
} from '@i18n/utils';

import PageLayout from '@layouts/PageLayout.astro';
import { linkTypeToUrl } from '@utils/linkUrl';
import type { Link } from '@models/Link';

import ListCard from '@components/list/ListCard.astro';
import ListItem from '@components/list/ListItem.astro';
import ListLink from '@components/list/ListLink.astro';
import ListItemEntry from '@components/list/ListItemEntry.astro';
import ListItemWrapper from '@components/list/ListItemWrapper.astro';

export async function getStaticPaths() {
  const canopies = await getCollection('canopies');
  const manufacturers = await getCollection('manufacturers');

  return buildStaticPaths(
    canopies.map(canopy => {
      const manufacturer = manufacturers.find(
        m => m.id === canopy.data.manufacturerSlug,
      );
      return {
        params: {
          canopy: canopy.data.slug,
          manufacturer: manufacturer?.id,
        },
        props: { canopy, manufacturer },
      };
    }),
  );
}

const { canopy, manufacturer } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);
---

<PageLayout pageTitle={canopy.data.name}>
  <h1 class="text-bw mb-6 text-center text-3xl font-extrabold">
    {canopy.data.name}
  </h1>
  <ListCard>
    <ListLink
      key={t('canopy.manufacturer')}
      linkUrl={translatePath(`/info/${manufacturer?.id}`)}
      linkName={manufacturer?.data.name}
    />
    <ListItem key={t('canopy.cells')} value={canopy.data.cells ?? '—'} />
    <ListItem key={t('canopy.category')} value={canopy.data.category ?? '—'} />
    <ListItem
      key={t('canopy.first-year-of-production')}
      value={canopy.data.firstYearOfProduction ?? '—'}
    />
    <ListItemWrapper>
      <ListItemEntry value={t('canopy.x-braced')} class="font-semibold" />
      <span
        class={`inline-flex items-center px-2 py-1 rounded font-bold ${canopy.data.xBraced ? 'bg-primary' : 'bg-secondary'}`}
        >{canopy.data.xBraced ? t('common.yes') : t('common.no')}</span
      >
    </ListItemWrapper>
    <ListItem
      key={`${t('canopy.min-size')} - ${t('canopy.max-size')}`}
      value={canopy.data.minSize && canopy.data.maxSize
        ? `${canopy.data.minSize}-${canopy.data.maxSize}`
        : '—'}
    />
  </ListCard>

  {
    canopy.data.links && canopy.data.links.length > 0 && (
      <ListCard class="mt-6">
        <ListItemWrapper>
          <h3 class="text-bw text-xl font-extrabold">{t('canopy.links')}</h3>
        </ListItemWrapper>
        {canopy.data.links.map(link => (
          <ListLink
            key={t(`link.${link?.type}` as TranslationKey)}
            linkUrl={linkTypeToUrl(link as Link)}
            linkName={link?.title ?? link?.type}
          />
        ))}
      </ListCard>
    )
  }
</PageLayout>
