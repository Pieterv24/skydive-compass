---
import { getCollection } from 'astro:content';

import {
  languages,
  showDefaultLang,
  defaultLang,
} from '../../../../../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../../../../../i18n/utils';

import BaseLayout from '../../../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const canopies = await getCollection('canopies');
  const manufacturers = await getCollection('manufacturers');

  return Object.keys(languages).flatMap(lang => {
    return canopies.map(canopy => {
      const manufacturer = manufacturers.find(
        m => m.id === canopy.data.manufacturerSlug,
      );
      if (!showDefaultLang && lang === defaultLang) {
        return {
          params: { canopy: canopy.data.slug, manufacturer: manufacturer?.id },
          props: { canopy, manufacturer },
        };
      }
      return {
        params: {
          canopy: canopy.data.slug,
          manufacturer: manufacturer?.id,
          lang,
        },
        props: { canopy, manufacturer },
      };
    });
  });
}

const { canopy, manufacturer } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout pageTitle={canopy.data.name}>
  <h2>Cells: {canopy.data.cells}</h2>
  <h2>Category: {canopy.data.category}</h2>
  <h3>
    Manufacturer: <a href={translatePath(`/info/${manufacturer?.id}`)}
      >{manufacturer?.data.name}</a
    >
  </h3>
</BaseLayout>
