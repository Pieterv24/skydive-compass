---
import { getCollection } from 'astro:content';

import {
  buildStaticPaths,
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
  type TranslationKey,
} from '@i18n/utils';

import PageLayout from '@layouts/PageLayout.astro';
import { linkTypeToUrl } from '@utils/linkUrl';
import type { Link } from '~/models/Link';

export async function getStaticPaths() {
  const canopies = await getCollection('canopies');
  const manufacturers = await getCollection('manufacturers');

  return buildStaticPaths(
    canopies.map(canopy => {
      const manufacturer = manufacturers.find(
        m => m.id === canopy.data.manufacturerSlug,
      );
      return {
        params: {
          canopy: canopy.data.slug,
          manufacturer: manufacturer?.id,
        },
        props: { canopy, manufacturer },
      };
    }),
  );
}

const { canopy, manufacturer } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const ulStyles =
  'divide-base-lighter bg-base mx-auto max-w-xl list-none divide-y rounded-xl';
const liStyles = '*:flex *:items-center *:justify-between *:px-4 *:py-4';
const spanStyles = '[&_span]:first:font-semibold **:text-bw';
const linkStyle =
  'text-bw hover:text-primary active:text-secondary font-semibold underline transition-colors';
---

<PageLayout pageTitle={canopy.data.name}>
  <h2 class="text-bw mb-6 text-center text-3xl font-extrabold">
    {canopy.data.name}
  </h2>
  <ul class={`${ulStyles} ${liStyles} ${spanStyles}`}>
    <li>
      <span>{t('canopy.manufacturer')}</span>
      <a href={translatePath(`/info/${manufacturer?.id}`)} class=`${linkStyle}`
        >{manufacturer?.data.name}</a
      >
    </li>
    <li>
      <span>{t('canopy.cells')}</span>
      <span>{canopy.data.cells ?? '—'}</span>
    </li>
    <li>
      <span>{t('canopy.category')}</span>
      <span>{canopy.data.category ?? '—'}</span>
    </li>
    <li>
      <span>{t('canopy.first-year-of-production')}</span>
      <span>{canopy.data.firstYearOfProduction ?? '—'}</span>
    </li>
    <li>
      <span>{t('canopy.x-braced')}</span>
      <span
        class={`inline-flex items-center px-2 py-1 rounded font-bold ${canopy.data.xBraced ? 'bg-primary' : 'bg-secondary'}`}
        >{canopy.data.xBraced ? t('common.yes') : t('common.no')}</span
      >
    </li>
    <li>
      <span>{t('canopy.min-size')} - {t('canopy.max-size')}</span>
      <span>
        {
          canopy.data.minSize && canopy.data.maxSize
            ? `${canopy.data.minSize}-${canopy.data.maxSize}`
            : '—'
        }
      </span>
    </li>
  </ul>

  {
    canopy.data.links && canopy.data.links.length > 0 && (
      <ul class={`mt-4 ${ulStyles} ${liStyles} ${spanStyles}`}>
        <li>
          <h3 class="text-bw text-xl font-extrabold">{t('canopy.links')}</h3>
        </li>
        {canopy.data.links.map(link => (
          <li>
            <span>{t(`link.${link?.type}` as TranslationKey)}</span>
            <a
              href={linkTypeToUrl(link as Link)}
              target="_blank"
              rel="noopener"
              class={linkStyle}
            >
              {link?.title ?? link?.type}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</PageLayout>
