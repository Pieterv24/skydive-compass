---
import { getCollection } from 'astro:content';
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
  buildStaticPaths,
} from '@i18n/utils';

import PageLayout from '@layouts/PageLayout.astro';

export async function getStaticPaths() {
  return buildStaticPaths();
}

const canopies = await getCollection('canopies');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pageTitle = t('nav.canopies');
---

<PageLayout pageTitle={pageTitle}>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
    {
      canopies.map(canopy => (
        <a
          href={translatePath(
            `/info/${canopy.data.manufacturerSlug}/${canopy.data.slug}`,
          )}
          class="border-base-lighter bg-base shadow-t-sm hover:bg-primary/10 focus:ring-primary block rounded-xl border px-5 py-4 transition-colors focus:ring-2 focus:outline"
        >
          <h4 class="text-bw mb-2 text-lg font-bold">{canopy.data.name}</h4>
          <div class="text-bw mb-1 flex flex-wrap gap-2 text-sm">
            <span class="bg-base-lighter text-bw rounded px-2 py-1">
              Cells: {canopy.data.cells}
            </span>
            <span class="bg-base-lighter text-bw rounded px-2 py-1">
              Category: {canopy.data.category}
            </span>
          </div>
        </a>
      ))
    }
  </div>
</PageLayout>
