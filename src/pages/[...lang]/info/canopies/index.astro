---
import { getCollection } from 'astro:content';
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
  buildStaticPaths,
} from '@i18n/utils';

import PageLayout from '@layouts/PageLayout.astro';
import ItemCard from '@components/ItemCard.astro';
import ItemCardTag from '@components/ItemCardTag.astro';

export async function getStaticPaths() {
  return buildStaticPaths();
}

const canopies = await getCollection('canopies');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pageTitle = t('nav.canopies');
---

<PageLayout pageTitle={pageTitle}>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
    {
      canopies.map(canopy => (
        <ItemCard
          href={translatePath(
            `/info/${canopy.data.manufacturerSlug}/${canopy.data.slug}`,
          )}
          title={canopy.data.name}
        >
          <ItemCardTag>Cells: {canopy.data.cells}</ItemCardTag>
          <ItemCardTag>Category: {canopy.data.category}</ItemCardTag>
        </ItemCard>
      ))
    }
  </div>
</PageLayout>
