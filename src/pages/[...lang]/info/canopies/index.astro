---
import { getCollection } from 'astro:content';
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
  buildStaticPaths,
} from '@i18n/utils';

import PageLayout from '@layouts/PageLayout.astro';
import ListCard from '~/components/ListCard.astro';
import ListCardTag from '~/components/ListCardTag.astro';

export async function getStaticPaths() {
  return buildStaticPaths();
}

const canopies = await getCollection('canopies');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pageTitle = t('nav.canopies');
---

<PageLayout pageTitle={pageTitle}>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
    {
      canopies.map(canopy => (
        <ListCard
          href={translatePath(
            `/info/${canopy.data.manufacturerSlug}/${canopy.data.slug}`,
          )}
          title={canopy.data.name}
        >
          <ListCardTag>Cells: {canopy.data.cells}</ListCardTag>
          <ListCardTag>Category: {canopy.data.category}</ListCardTag>
        </ListCard>
      ))
    }
  </div>
</PageLayout>
