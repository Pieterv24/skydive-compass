---
import { getCollection } from 'astro:content';
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
  buildStaticPaths,
} from '@i18n/utils';

import PageLayout from '@layouts/PageLayout.astro';

export async function getStaticPaths() {
  return buildStaticPaths();
}

const manufacturers = await getCollection('manufacturers');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pageTitle = t('nav.manufacturers');
---

<PageLayout pageTitle={pageTitle}>
  <div
    class="grid grid-cols-1 gap-6 px-2 sm:grid-cols-2 sm:px-4 md:grid-cols-3 md:px-8"
  >
    {
      manufacturers.map(manufacturer => (
        <a
          href={translatePath(`/info/${manufacturer.id}`)}
          class="border-base-lighter bg-base shadow-t-sm hover:bg-primary/10 focus:ring-primary block rounded-xl border px-5 py-4 transition-colors focus:ring-2 focus:outline"
        >
          <h4 class="text-bw mb-2 text-lg font-bold">
            {manufacturer.data.name}
          </h4>
          <div class="text-bw mb-1 flex flex-wrap gap-2 text-sm">
            {manufacturer.data.countrycode && (
              <span class="bg-base-lighter text-bw rounded px-2 py-1">
                {manufacturer.data.countrycode.toUpperCase()}
              </span>
            )}
            {manufacturer.data.url && (
              <span class="bg-base-lighter text-primary rounded px-2 py-1 underline">
                Website
              </span>
            )}
          </div>
        </a>
      ))
    }
  </div>
</PageLayout>
