---
import { getCollection } from 'astro:content';
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
  buildStaticPaths,
} from '@i18n/utils';

import PageLayout from '@layouts/PageLayout.astro';
import ListCard from '~/components/ListCard.astro';
import ListCardTag from '~/components/ListCardTag.astro';

export async function getStaticPaths() {
  return buildStaticPaths();
}

const manufacturers = await getCollection('manufacturers');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pageTitle = t('nav.manufacturers');
---

<PageLayout pageTitle={pageTitle}>
  <div
    class="grid grid-cols-1 gap-6 px-2 sm:grid-cols-2 sm:px-4 md:grid-cols-3 md:px-8"
  >
    {
      manufacturers.map(manufacturer => (
        <ListCard
          href={translatePath(`/info/${manufacturer.id}`)}
          title={manufacturer.data.name}
        >
          {manufacturer.data.countryCode && (
            <ListCardTag>
              {manufacturer.data.countryCode.toUpperCase()}
            </ListCardTag>
          )}
        </ListCard>
      ))
    }
  </div>
</PageLayout>
