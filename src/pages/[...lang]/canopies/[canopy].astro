---
import { getCollection } from 'astro:content';

import { languages, showDefaultLang, defaultLang } from '../../../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';

import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const canopies = await getCollection('canopies');
  const manufacturers = await getCollection('manufacturers');

  return Object.keys(languages).flatMap(lang => {
    return canopies.map(({ data: canopy }) => {
      const manufacturer = manufacturers.find(
        m => m.id === canopy.manufacturerSlug,
      )?.data || { slug: '', name: '' };
      if (!showDefaultLang && lang === defaultLang) {
        return {
          params: { canopy: `${manufacturer.slug}-${canopy.slug}` },
          props: { canopy, manufacturer },
        };
      }
      return {
        params: { canopy: `${manufacturer.slug}-${canopy.slug}`, lang },
        props: { canopy, manufacturer },
      };
    });
  });
}

const { canopy, manufacturer } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout pageTitle={canopy.name}>
  <h2>Cells: {canopy.cells}</h2>
  <h2>Category: {canopy.category}</h2>
  <h3>
    Manufacturer: <a href={translatePath(`/manufacturers/${manufacturer.slug}`)}
      >{manufacturer.name}</a
    >
  </h3>
</BaseLayout>
