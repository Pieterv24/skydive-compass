---
import { languages, showDefaultLang, defaultLang } from '../../../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import canopies from '../../../data/canopies.json';
import manufacturers from '../../../data/manufacturers.json';

export async function getStaticPaths() {
  return Object.keys(languages).flatMap(lang => {
    return canopies.map(canopy => {
      const manufacturer = manufacturers.filter(
        entry => entry.id === canopy.manufacturerid,
      )[0];
      if (!showDefaultLang && lang === defaultLang) {
        return {
          params: { canopy: canopy.id },
          props: { canopy, manufacturer },
        };
      }
      return {
        params: { canopy: canopy.id, lang },
        props: { canopy, manufacturer },
      };
    });
  });
}

const { canopy, manufacturer } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout pageTitle={canopy.name}>
  <h2>Cells: {canopy.cells}</h2>
  <h2>Category: {canopy.category}</h2>
  <h3>
    Manufacturer: <a href={translatePath(`/manufacturers/${manufacturer.id}`)}
      >{manufacturer.name}</a
    >
  </h3>
</BaseLayout>
