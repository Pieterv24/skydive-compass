---
import { languages, showDefaultLang, defaultLang } from '../../i18n/ui';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => {
    if (!showDefaultLang && lang === defaultLang) {
      return { params: { lang: undefined } };
    }
    return { params: { lang } };
  });
}

const langFromUrl = getLangFromUrl(Astro.url);
const t = useTranslations(langFromUrl);

const pageTitle = t('site.title');
---

<BaseLayout pageTitle={pageTitle} />
