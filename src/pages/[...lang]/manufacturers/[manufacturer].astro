---
import { languages, showDefaultLang, defaultLang } from '../../../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import canopies from '../../../data/canopies.json';
import manufacturers from '../../../data/manufacturers.json';

export async function getStaticPaths() {
  return Object.keys(languages).flatMap(lang => {
    return manufacturers.map(manufacturer => {
      const filteredCanopies = canopies.filter(
        canopy => canopy.manufacturerid === manufacturer.id,
      );
      if (!showDefaultLang && lang === defaultLang) {
        return {
          params: { manufacturer: manufacturer.id },
          props: { manufacturer, filteredCanopies },
        };
      }
      return {
        params: { manufacturer: manufacturer.id, lang },
        props: { manufacturer, filteredCanopies },
      };
    });
  });
}

const { manufacturer, filteredCanopies } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout pageTitle={manufacturer.name}>
  <ul>
    {
      filteredCanopies.map(canopy => (
        <li>
          <a href={translatePath(`/canopies/${canopy.id}`)}>{canopy.name}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
