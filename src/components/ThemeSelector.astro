---
import { css, cx } from '@panda/css';
import { panda } from '@panda/jsx';

const ToggleButton = panda('button', {
  base: {
    borderColor: { base: 'primary.9', _dark: 'primary.9' },
    bg: {
      base: 'transparent',
      _groupHover: 'primary.9',
      _groupFocusWithin: 'primary.9',
      _groupActive: 'primary.9',
    },
    _hover: {
      cursor: 'pointer',
    },
  },
});

const ThemeSelectorPopover = panda('div', {
  base: {
    bg: { base: 'gray.light.5', _dark: 'gray.dark.9' },
    _groupFocusWithin: {
      display: 'block',
    },
    _hover: {
      display: 'block',
    },
  },
});

const ListItem = panda('li', {
  base: {
    userSelect: 'none',
    paddingY: '1',
    paddingX: '2',
    _hover: {
      backgroundColor: 'black.a.4',
      cursor: 'pointer',
    },
  },
});

const iconActions = css({
  fill: {
    base: 'primary.9',
    _groupFocusWithin: 'background',
    _groupHover: 'background',
    _groupActive: 'background',
  },
});

const sunIconVisibility = css({
  display: { base: 'inline', _dark: 'none' },
});

const moonIconVisibility = css({
  display: { base: 'none', _dark: 'inline' },
});
---

<panda.div className="group" position="relative">
  <ToggleButton
    id="themeToggle"
    className="group"
    borderRadius="xl"
    borderWidth="2"
    width="9"
    height="9"
    display="flex"
    alignItems="='center'"
    justifyContent="center"
    padding="1"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960">
      <path
        class={cx(iconActions, moonIconVisibility)}
        d="M600-640 480-760l120-120 120 120-120 120Zm200 120-80-80 80-80 80 80-80 80ZM483-80q-84 0-157.5-32t-128-86.5Q143-253 111-326.5T79-484q0-146 93-257.5T409-880q-18 99 11 193.5T520-521q71 71 165.5 100T879-410q-26 144-138 237T483-80Zm0-80q88 0 163-44t118-121q-86-8-163-43.5T463-465q-61-61-97-138t-43-163q-77 43-120.5 118.5T159-484q0 135 94.5 229.5T483-160Zm-20-305Z"
      ></path>
      <path
        class={cx(iconActions, sunIconVisibility)}
        d="M480-28 346-160H160v-186L28-480l132-134v-186h186l134-132 134 132h186v186l132 134-132 134v186H614L480-28Zm0-252q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680q-83 0-141.5 58.5T280-480q0 83 58.5 141.5T480-280Zm0-200Zm0 340 100-100h140v-140l100-100-100-100v-140H580L480-820 380-720H240v140L140-480l100 100v140h140l100 100Zm0-340Z"
      ></path>
    </svg>
  </ToggleButton>
  <ThemeSelectorPopover
    position="absolute"
    display="none"
    color="text"
    borderRadius="md"
    zIndex="1000"
    right="0"
    marginTop="2"
  >
    <ul>
      <ListItem id="setSystem">System</ListItem>
      <ListItem id="setDark">Dark</ListItem>
      <ListItem id="setLight">Light</ListItem>
    </ul>
  </ThemeSelectorPopover>
</panda.div>

<script is:inline>
  const getTheme = () => {
    const localStorageTheme = localStorage?.getItem('theme') ?? '';
    if (['dark', 'light'].includes(localStorageTheme)) {
      return localStorageTheme;
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
    return 'light';
  };

  const theme = getTheme();
  if (theme === 'light') {
    document.documentElement.classList.remove('dark');
  } else {
    document.documentElement.classList.add('dark');
  }

  window.localStorage.setItem('theme', theme);

  const setTheme = selectedTheme => {
    if (selectedTheme === 'system') {
      localStorage.removeItem('theme');
    } else {
      localStorage.setItem('theme', selectedTheme);
    }

    const isDark = getTheme() === 'dark';
    const documentRoot = document.documentElement;
    if (documentRoot.classList.contains('dark') && !isDark) {
      documentRoot.classList.remove('dark');
    } else if (!documentRoot.classList.contains('dark') && isDark) {
      documentRoot.classList.add('dark');
    }
  };

  document
    .getElementById('setSystem')
    ?.addEventListener('click', () => setTheme('system'));
  document
    .getElementById('setDark')
    ?.addEventListener('click', () => setTheme('dark'));
  document
    .getElementById('setLight')
    ?.addEventListener('click', () => setTheme('light'));
</script>
