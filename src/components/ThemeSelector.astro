---

---

<div class="group/toggle relative cursor-pointer">
  <button
    id="themeToggle"
    class="group/button border-primary hover:bg-primary active:border-secondary flex h-9 w-9 cursor-pointer items-center justify-items-center rounded-xl border-2"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="themeDropdown"
    aria-label="Theme selector. Choose between system, dark, or light mode."
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 -960 960 960"
      class="p-1"
    >
      <path
        id="moon"
        class="fill-primary group-hover/button:fill-base group-active/button:fill-secondary hidden dark:inline"
        d="M600-640 480-760l120-120 120 120-120 120Zm200 120-80-80 80-80 80 80-80 80ZM483-80q-84 0-157.5-32t-128-86.5Q143-253 111-326.5T79-484q0-146 93-257.5T409-880q-18 99 11 193.5T520-521q71 71 165.5 100T879-410q-26 144-138 237T483-80Zm0-80q88 0 163-44t118-121q-86-8-163-43.5T463-465q-61-61-97-138t-43-163q-77 43-120.5 118.5T159-484q0 135 94.5 229.5T483-160Zm-20-305Z"
      ></path>
      <path
        id="sun"
        class="fill-primary group-hover/button:fill-base group-active/button:fill-secondary inline dark:hidden"
        d="M480-28 346-160H160v-186L28-480l132-134v-186h186l134-132 134 132h186v186l132 134-132 134v186H614L480-28Zm0-252q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680q-83 0-141.5 58.5T280-480q0 83 58.5 141.5T480-280Zm0-200Zm0 340 100-100h140v-140l100-100-100-100v-140H580L480-820 380-720H240v140L140-480l100 100v140h140l100 100Zm0-340Z"
      ></path>
    </svg>
  </button>
  <div
    id="themeDropdown"
    class="text-bw bg-bw-inverse absolute right-0 z-10 mt-2 hidden rounded-md shadow-md"
    role="listbox"
    aria-label="Theme options"
  >
    <ul
      class="*:px-2 *:py-1 *:select-none *:first:rounded-t-md *:last:rounded-b-md *:hover:bg-black/5 *:active:bg-black/20 *:dark:hover:bg-white/20 *:dark:active:bg-white/35"
    >
      <li id="setSystem" role="option" aria-label="System theme" tabindex="0">
        System
      </li>
      <li id="setDark" role="option" aria-label="Dark theme" tabindex="0">
        Dark
      </li>
      <li id="setLight" role="option" aria-label="Light theme" tabindex="0">
        Light
      </li>
    </ul>
  </div>
</div>

<script>
  import { setTheme } from '@utils/darkMode';

  document.addEventListener('DOMContentLoaded', function () {
    const toggleBtn = document.getElementById('themeToggle');
    const dropdown = document.getElementById('themeDropdown');

    function closeDropdown() {
      if (dropdown) dropdown.classList.add('hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    }

    function openDropdown() {
      if (dropdown) dropdown.classList.remove('hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
    }

    if (toggleBtn && dropdown) {
      console.log('add listener');
      console.log(toggleBtn);
      toggleBtn.addEventListener('click', function (e) {
        console.log('click');
        e.stopPropagation();
        if (dropdown.classList.contains('hidden')) {
          openDropdown();
        } else {
          closeDropdown();
        }
      });
    }

    // Close dropdown on outside click
    document.addEventListener('click', function (e) {
      if (
        toggleBtn &&
        e.target instanceof Node &&
        !toggleBtn.contains(e.target)
      ) {
        closeDropdown();
      }
    });

    // Theme selection
    document
      .getElementById('setSystem')
      ?.addEventListener('click', function () {
        setTheme('system');
        closeDropdown();
      });
    document.getElementById('setDark')?.addEventListener('click', function () {
      setTheme('dark');
      closeDropdown();
    });
    document.getElementById('setLight')?.addEventListener('click', function () {
      setTheme('light');
      closeDropdown();
    });
  });
</script>
