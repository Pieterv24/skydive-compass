---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<a href={translatePath('')}>{t('nav.compass')}</a>
<a href={translatePath('info/canopies')}>{t('nav.canopies')}</a>
<a href={translatePath('info/manufacturers')}>{t('nav.manufacturers')}</a>
