---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div
  class="*:hover:text-primary *:active:text-secondary col-span-2 hidden grid-cols-1 text-center md:col-auto md:grid md:grid-cols-3"
>
  <a href={translatePath('')}>{t('nav.compass')}</a>
  <a href={translatePath('info/canopies')}>{t('nav.canopies')}</a>
  <a href={translatePath('info/manufacturers')}>{t('nav.manufacturers')}</a>
</div>
