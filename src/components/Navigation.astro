---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { class: className } = Astro.props;
---

<div
  class={`grid grid-cols-1 md:grid-cols-3 *:w-min *:hover:text-primary *:active:text-secondary justify-items-center ${className}`}
>
  <a href={translatePath('./')}>{t('nav.compass')}</a>
  <a href={translatePath('info/canopies')}>{t('nav.canopies')}</a>
  <a href={translatePath('info/manufacturers')}>{t('nav.manufacturers')}</a>
</div>
