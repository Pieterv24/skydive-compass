---
const { href, title, class: className } = Astro.props;
---

<a
  href={href}
  class={`block px-5 py-4 rounded-xl border border-base-lighter bg-base transition-colors focus:outline focus:ring-2 focus:ring-primary hover:bg-primary/10 active:bg-primary/20 active:border-primary ${className ?? ''}`}
  aria-label={title}
>
  <h4 class="text-bw mb-2 text-lg font-bold">{title}</h4>
  <div class="text-bw mb-1 flex flex-wrap gap-2 text-sm">
    <slot />
  </div>
</a>
