---
import { panda, Grid } from '@panda/jsx';

import ThemeSelector from './ThemeSelector.astro';

import { useTranslations } from '@i18n/utils';
import Navigation from './Navigation.astro';

const t = useTranslations(Astro.url);
---

<Grid
  backgroundColor="background"
  columns={{ base: 2, md: 3 }}
  alignItems="center"
  paddingY="4"
  paddingX="8"
  gap="4"
>
  <panda.div display="flex" gap="2" alignItems="center">
    <panda.img
      src="cropped_alti_compass.png"
      alt="Skydive Compass Logo"
      width="8"
      height="auto"
    />
    <panda.h1 fontSize="xl">{t('site.title')}</panda.h1>
  </panda.div>
  <panda.div
    display={{ base: 'block', md: 'none' }}
    justifySelf="flex-end"
    gridColumn="2"
  >
    <h1>Ham</h1>
  </panda.div>
  <Grid
    columns={{ base: 1, md: 3 }}
    textAlign="center"
    display={{ base: 'none', md: 'grid' }}
    gridColumn={{ base: 'span 2', md: 'auto' }}
  >
    <Navigation />
  </Grid>
  <panda.div
    justifySelf={{ base: 'start', md: 'end' }}
    display={{ base: 'none', md: 'block' }}
    gridColumn={{ base: 'span 2', md: 'auto' }}
  >
    <ThemeSelector />
  </panda.div>
</Grid>
