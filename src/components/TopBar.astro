---
import ThemeSelector from './ThemeSelector.astro';
// import ThemeSelector from './ThemeSelector';
import LanguageSelector from './LanguageSelector.astro';
import SiteTitle from './SiteTitle.astro';
import Hamburger from './Hambuger.astro';

import Navigation from './Navigation.astro';
---

<div
  class="bg-base grid grid-cols-2 items-center gap-4 px-8 py-4 md:grid-cols-3"
>
  <SiteTitle />
  <!-- <div class="col-2 block md:hidden justify-end flex"> -->
  <Hamburger class="col-2 block justify-self-end md:hidden" />
  <Navigation class="col-span-2 grid md:col-span-1 md:grid" />
  <div
    class="col-span-2 grid grid-cols-2 justify-end gap-2 justify-self-start md:col-auto md:grid md:justify-self-end"
  >
    <LanguageSelector />
    <!-- <ThemeSelector client:only="react" /> -->
    <ThemeSelector />
  </div>
</div>
