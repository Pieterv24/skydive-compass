{
  "name": "skydive-compass",
  "description": "Webcomponent skydive-compass following open-wc recommendations",
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Pieterv24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.html . && prettier \"**/*.js\" --check --ignore-path .gitignore",
    "format": "eslint --ext .js,.html . --fix && prettier \"**/*.js\" --write --ignore-path .gitignore",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "git-cz"
  },
  "dependencies": {
    "@lion/ui": "^0.13.0",
    "@lit-labs/router": "^0.1.4",
    "@lit-labs/scoped-registry-mixin": "^1.0.4",
    "@material/web": "^2.3.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "dark-theme-utils": "^0.4.0",
    "lit": "^3.1.4",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@eslint/compat": "^1.3.1",
    "@open-wc/eslint-config": "^13.0.0",
    "commitizen": "^4.3.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.11",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "vite": "^7.0.6"
  },
  "peerDependencies": {
    "inquirer": "^9.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
