{
  "name": "skydive-compass-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "rimraf dist && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro && prettier \"**/*.{js,mjs,ts,mts,html,json}\" --check",
    "format": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix && prettier \"**/*.{js,mjs,ts,mts,html,json}\" --write",
    "prepare": "husky && panda codegen",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "commit": "lint-staged && git-cz --no-verify"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.4.2",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/lexend": "^5.2.9",
    "astro": "^5.12.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "@pandacss/dev": "^0.54.0",
    "@pandacss/preset-base": "^1.0.0",
    "@pandacss/preset-panda": "^1.0.0",
    "@radix-ui/colors": "^3.0.0",
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/parser": "^8.38.0",
    "commitizen": "^4.3.1",
    "eslint": "^9.32.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "pandacss-preset-radix-colors": "^0.2.0",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.0.1",
    "typescript-eslint": "^8.38.0"
  },
  "peerDependencies": {
    "inquirer": "^9.0.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
