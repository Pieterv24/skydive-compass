{
  "name": "skydive-compass",
  "description": "Webcomponent skydive-compass following open-wc recommendations",
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Pieterv24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.html . --ignore-path .gitignore && prettier \"**/*.js\" --check --ignore-path .gitignore",
    "format": "eslint --ext .js,.html . --fix --ignore-path .gitignore && prettier \"**/*.js\" --write --ignore-path .gitignore",
    "prepare": "husky"
  },
  "dependencies": {
    "@lion/ui": "^0.13.0",
    "@lit-labs/scoped-registry-mixin": "^1.0.4",
    "@material/web": "^2.3.0",
    "@open-wc/scoped-elements": "^3.0.6",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "dark-theme-utils": "^0.4.0",
    "lit": "^3.1.4"
  },
  "devDependencies": {
    "@open-wc/eslint-config": "^12.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "vite": "^7.0.6"
  },
  "eslintConfig": {
    "extends": [
      "@open-wc",
      "prettier"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "customElements": "custom-elements.json"
}
